# 复制为 .env 并填入真实 key。
# 保留中文占位符时平台会自动进入 Mock 模式。
export DEEPSEEK_API_KEY="请填入你的 DeepSeek API Key"

# 可选
# export DSH_MODEL="deepseek-v4-flash"
# export DSH_PROVIDER="deepseek-official"
# export DEEPSEEK_BASE_URL=""

# 人工审批(HITL):默认开启,等待 120 秒;DSH_APPROVAL_TOOLS 可强制指定工具
# export DSH_APPROVAL_BRIDGE="1"
# export DSH_APPROVAL_TIMEOUT="120"
# export DSH_APPROVAL_TOOLS="bash,write,edit"
